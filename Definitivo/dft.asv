function X = dft(x)

    sz = size(x); % Vettore dimensioni x
    nd = sum(sz > 1); % Sommatoria vettore dei booleani 

    if nd == 1
        % --- Caso vettore (riga o colonna)
        dim = find(sz > 1, 1);   % comportamento identico a FFT
    else
        % --- Caso matrice: trasformo per colonne
        dim = 1;
    end

    % Estraggo lunghezza della DFT
    N = sz(dim);

    % Costruzione matrice di trasformazione
    n = 0:N-1;
    k = 0:N-1;
    F = exp(-j*2*pi*n'*k/N);
    % Applico DFT lungo la dimensione desiderata
    X = shiftdim(X, dim-1);   % porta la dimensione scelta davanti
    Xk = W * X;               % moltiplicazione vettoriale
    Xk = shiftdim(Xk, -(dim-1)); % ripristina il layout originale

X = (F*x')';

end