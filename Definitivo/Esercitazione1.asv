clear all
close all
clc

% Rendiamo un pezzo di 30 secondi del .waw in un vettore di campioni con
% sua frequenza di campionamento
[y, Fs] = audioread("Metallica - Fuel.wav", [1323001 2646000]);

ly = length(y);
t = ly / Fs;
M = 0.5; % Fattore di campionamento intervallo
lint = Fs * M; % Numero di campioni per intervallo
nint = t/M; % Numero di intervalli 
n = (0:ly-1)/Fs; % Intervallo normalizzato per andare da 0 a 30

figure
hold on
plot(n, y(:, 1));
title("Plot canzone");



% Reshape prende in ordine gli elementi degli array e li mette a matrice
% completando per colonna (prima colonna 1, poi 2, ..., poi n)
y = (y(:,1))'; % Traspongo perche boh sembra serva una riga per reshape
x = reshape(y, lint, t/M); % Faccio la matrice tale che per ogni colonna ho un intervallo

figure
hold on
plot(linspace(0, (lint-1)/Fs, lint), x(:, 1)); % Adesso x va letto su tutta la colonna per i campioni
title("Plot primo intervallo");


format long e
ggg = linspace(0, (lint-1)/Fs, lint);
fff = (0:lint-1)/Fs;
lll = fff - ggg;
sum(lll)

z = abs(x(:, 1)); % Spettro di x

figure
hold on
plot(linspace(0, (lint-1)/Fs, lint), z); % Adesso x va letto su tutta la colonna per i campioni
title("Plot spettro primo intervallo");


% La fft trasforma una matrice per colonne, ovvero ogni colonna è vista 
% come un segnale da un numero di campioni = alle righe
Xf = fft(x); 


% Ho implementato la dft in modo da avere lo stesso comportamento
% Quindi mi aspetto che lungo una colonna ci sia un segnale da trasformare
Xd = dft(x);



